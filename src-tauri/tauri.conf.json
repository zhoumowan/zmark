{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zmark",
  "version": "1.6.2",
  "identifier": "cn.fanzong.zmark",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zmark"]
      }
    },
    "sql": {
      "enabled": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/zhoumowan/zmark/releases/latest/download/latest.json"
      ],
      "pubkey": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAx5PUWrMVbopQpVsIHrJa\n6ozm9+S0TbisvgDVYjNvJiONbq1upODMUUFsqFgCV4vARJeqvC1oE3R2v9wWab87\nwpFOAk9GbVhqQ8EFI6+aBq74VA0u+sx0LFfIxxns3RSWazm+a4NmAbcxkZICSBAm\n12SAi79/jY/dXSHdyARo+2bW2OmXsDIuLOThEMmwRqg8EB+N3gho3UU4WGw3qC5S\n4BnTUPiKDWqc6T5bj28B+RJVnGAOSO6UUVeDMtmRvq3OAh8xEd6+GAQFyI5y9Adl\nKjQGDo83cvOOC1xtliRxn77WRMZv8fYKckHVwEWlmqYDA9EY0AO/pomRxaIXJ/oa\nGQIDAQAB\n-----END PUBLIC KEY-----",
      "dialog": true,
      "installMode": "promptPassive"
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zmark",
        "label": "main",
        "width": 1200,
        "height": 800,
        "visible": true,
        "fullscreen": false
      },
      {
        "title": "Quick Capture",
        "label": "capture",
        "width": 600,
        "height": 250,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc:; img-src * asset: data: blob:; font-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src * asset: ipc:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["zmark"],
        "name": "ZMark Document",
        "description": "ZMark Document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zmark",
  "version": "1.6.2",
  "identifier": "cn.fanzong.zmark",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zmark"]
      }
    },
    "sql": {
      "enabled": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/zhoumowan/zmark/releases/latest/download/latest.json"
      ],
      "pubkey": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAsrL9dHcZ6LieBF/ftt0S\nPMJmvGyVK0oRbqkSQ+YdbPz/mONaGBCAVMs+NwJClYljdQNiU4axSetcu3MwgkDG\nWdkbU6dN5+zTewgEFvjNhDR0rc7wjE9ZF1k11+hXoE8fWFL6rsuxtkAXrJMUjUPP\nFVbrH3KrRRN6gJ/U8BSyW3A7j0cAK390Q3kE3IWrhcaHWzfmH9JfmVAQmGlak7Xt\ne/+MVxM4zP3HRYPGdywehK7aMOsCq65b1vzZmldyxndSAT2v1Fz1Hw3Q6oIsv7ij\nNj8Ez8wNqRQIxRGixDyG4wRUO4hISinEg2wp3RcadHYUFrxR9pPV3R11nw2hqj3M\neQIDAQAB\n-----END PUBLIC KEY-----",
      "dialog": true,
      "installMode": "promptPassive"
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zmark",
        "label": "main",
        "width": 1200,
        "height": 800,
        "visible": true,
        "fullscreen": false,
        "devtools": true
      },
      {
        "title": "Quick Capture",
        "label": "capture",
        "width": 600,
        "height": 250,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc:; img-src * asset: data: blob:; font-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src * asset: ipc:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["zmark"],
        "name": "ZMark Document",
        "description": "ZMark Document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
